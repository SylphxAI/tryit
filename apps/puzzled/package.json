{
	"name": "@sylphx/puzzled",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "vite --host 0.0.0.0 --port 3000",
		"build": "vite build",
		"build:with-migrate": "atlas migrate apply --env production && bun run build",
		"start": "node .output/server/index.mjs",
		"verify:seo": "bun run scripts/seo-verify.ts",
		"verify:locale": "bun run scripts/locale-verify.ts",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"check": "biome check --write .",
		"typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.e2e.json",
		"test": "bun test --isolate src tests '.test.ts'",
		"test:unit": "bun test --isolate src '.test.ts'",
		"test:e2e": "playwright test",
		"test:a11y": "playwright test e2e-tests/a11y.e2e.ts e2e-tests/accessibility.e2e.ts e2e-tests/language-menu.e2e.ts",
		"test:settings": "playwright test e2e-tests/settings-profile.e2e.ts",
		"lighthouse": "lhci autorun",
		"test:vitals": "playwright test e2e-tests/web-vitals.e2e.ts --workers=1 --retries=0",
		"atlas:diff": "atlas migrate diff --env local",
		"atlas:apply": "atlas migrate apply --env local",
		"atlas:status": "atlas migrate status --env local",
		"atlas:validate": "atlas migrate validate --env local",
		"atlas:hash": "atlas migrate hash --env local",
		"db:studio": "drizzle-kit studio",
		"db:export": "drizzle-kit export"
	},
	"dependencies": {
		"@bufbuild/protobuf": "^2.2.0",
		"@connectrpc/connect": "^2.0.0",
		"@connectrpc/connect-web": "^2.0.0",
		"@resvg/resvg-js": "2.6.2",
		"@solidjs/meta": "0.29.8",
		"@solidjs/router": "0.16.3",
		"@solidjs/start": "2.2.3",
		"@sylphx/sdk": "^0.31.0",
		"clsx": "^2.1.1",
		"cookie-es": "3.1.1",
		"drizzle-orm": "^0.45.1",
		"intl-messageformat": "11.1.2",
		"lucide-solid": "0.577.0",
		"pg": "^8.16.3",
		"satori": "0.63.2",
		"server-only": "^0.0.1",
		"solid-js": "1.9.20",
		"tailwind-merge": "^3.4.0"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.11.0",
		"@biomejs/biome": "2.6.4",
		"@happy-dom/global-registrator": "20.14.6",
		"@lhci/cli": "^0.15.1",
		"@playwright/test": "^1.58.0",
		"@tailwindcss/vite": "4.3.5",
		"@types/bun": "1.4.4",
		"@types/node": "^26.0.0",
		"@types/pg": "^8.11.14",
		"@types/ws": "^8.18.1",
		"dotenv": "^17.2.3",
		"drizzle-kit": "^0.31.8",
		"happy-dom": "20.14.6",
		"nitro": "3.0.261103-rc",
		"playwright": "^1.58.0",
		"tailwindcss": "4.3.5",
		"tailwindcss-animate": "^1.0.7",
		"typescript": "^5.9.3",
		"vite": "8.3.8"
	}
}
