{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["dom", "dom.iterable", "esnext"],
		"allowJs": true,
		"skipLibCheck": true,
		"strict": true,
		"noEmit": true,
		"esModuleInterop": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"jsx": "preserve",
		"incremental": true,
		"paths": {
			"@/*": ["./src/*"],
			"server-only": ["./scripts/shims/server-only.ts"]
		},
		"jsxImportSource": "solid-js"
	},
	"include": ["**/*.ts", "**/*.tsx", "**/*.mts"],
	"exclude": [
		"node_modules",
		"e2e-tests",
		"playwright.config.ts",
		"**/*.test.ts",
		"**/*.test.tsx",
		"tests",
		".output",
		".nitro"
	]
}
