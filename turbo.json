{
	"$schema": "https://turbo.build/schema.json",
	"ui": "tui",
	"remoteCache": {
		"enabled": true,
		"signature": true
	},
	"globalDependencies": [".env*"],
	"globalPassThroughEnv": [
		"DESK_*",
		"DATABASE_URL",
		"POSTGRES_*",
		"PG*",
		"REDIS_URL",
		"STORAGE_*",
		"TRIGGER_*",
		"SYLPHX_*",
		"GOOGLE_CLIENT_*",
		"VAPID_*",
		"EMAIL_UNSUBSCRIBE_SECRET",
		"INIT_SECRET",
		"INITIAL_SUPERADMIN_EMAIL",
		"NODE_ENV",
		"SKIP_DB_MIGRATE",
		"SKIP_ENV_VALIDATION",
		"PLATFORM_ENCRYPTION_KEY",
		"NODE_OPTIONS",
		"CI"
	],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": [".output/**", "dist/**"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"lint": {},
		"typecheck": {},
		"test": {
			"dependsOn": ["^build"]
		},
		"clean": {
			"cache": false
		}
	}
}
